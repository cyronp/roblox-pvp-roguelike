{
  "name": "Test",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Packages": {
        "$path": "Packages"
      },
      "RevolverFire": {
        "$className": "RemoteEvent"
      },
      "KillConfirmed": {
        "$className": "RemoteEvent"
      }
    },

    "SoundService": {
      "KillConfirmation": {
        "$className": "Sound",
        "$properties": {
          "SoundId": "rbxassetid://83811330659090",
          "Volume": 0.65,
          "Looped": false
        }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "ServerStorage": {
      "Revolver": {
        "$className": "Tool",
        "$properties": {
          "CanBeDropped": false,
          "RequiresHandle": true,
          "ToolTip": "Six shots; reloads automatically"
        },
        "Handle": {
          "$className": "Part",
          "$properties": {
            "Size": [0.35, 0.85, 0.35],
            "Color": [0.24, 0.13, 0.08],
            "Material": "Wood",
            "CanCollide": false,
            "Massless": true
          },
          "FireSound": {
            "$className": "Sound",
            "$properties": {
              "SoundId": "rbxassetid://114169781286214",
              "Volume": 0.65,
              "Looped": false,
              "RollOffMode": "InverseTapered",
              "RollOffMinDistance": 12,
              "RollOffMaxDistance": 180
            }
          }
        },
        "Client": {
          "$path": "src/tools/Revolver.client.luau"
        },
        "AmmoHud": {
          "$path": "src/tools/RevolverAmmoHud.luau"
        }
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMode": "Classic",
        "CameraMinZoomDistance": 5
      },
      "StarterPlayerScripts": {
        "$ignoreUnknownInstances": false,
        "Client": {
          "$path": "src/client"
        }
      }
    }
  }
}
